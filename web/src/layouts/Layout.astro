---
import '../styles/global.css';
import ProjectLayout from '@dunn.dev/reference/chrome/ProjectLayout.astro';
import markSvg from '../mark.svg?raw';

interface Props {
  description?: string;
}
---
<ProjectLayout
  {...Astro.props}
  siteName="bairn.dunn.dev"
  tagline="collected moments of early learning"
  mark={markSvg}
  nav={[{ href: 'https://gitlab.com/dunn.dev/bairn/-/releases', label: 'Releases' }]}
  repoUrl="https://gitlab.com/dunn.dev/bairn"
  repoLabel="gitlab.com/dunn.dev/bairn"
>
  <slot />
</ProjectLayout>
